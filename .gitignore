# Python
__pycache__/
eval/__pycache__/
*/__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.ipynb_checkpoints/

# Data / models
/data/raw/*
/data/interim/*
/data/processed/*
/runs/*
/checkpoints/*
/artifacts/*

# Keep folder structure
!/data/raw/.gitkeep
!/data/interim/.gitkeep
!/data/processed/.gitkeep
!/models/.gitkeep
!/runs/.gitkeep
!/checkpoints/.gitkeep
!/artifacts/.gitkeep

# Keep sweep leaderboard metadata so teammates can read it without rsync
!/artifacts/sweeps/
!/artifacts/sweeps/LEADERBOARD.csv
!/artifacts/sweeps/LEADERBOARD.md
!/artifacts/sweeps/m_*.json

# Track-provided Infineon data
!/data/raw/infineon/
!/data/raw/infineon/**


# OS / IDE
.DS_Store
.vscode/settings.json

# Slurm / runtime logs
logs/
slurm-*.out

# Leonardo / HPC transfer artifacts
leo_results_gpu.tgz
_leo_results_gpu/
*.tgz

# Local/GPU model checkpoints
models/*.pt
models/*.pt.best
models/sweeps/*.pt
models/sweeps/*.pkl

# Keep best sweep checkpoints (tracked via git lfs)
!models/sweeps/*.pt.best
