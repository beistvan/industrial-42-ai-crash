# Python
__pycache__/
eval/__pycache__/
*/__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.ipynb_checkpoints/

# Data / models
/data/raw/*
/data/interim/*
/data/processed/*
/runs/*
/checkpoints/*
/artifacts/*

# Keep folder structure
!/data/raw/.gitkeep
!/data/interim/.gitkeep
!/data/processed/.gitkeep
!/models/.gitkeep
!/runs/.gitkeep
!/checkpoints/.gitkeep
!/artifacts/.gitkeep

# Keep sweep leaderboard metadata so teammates can read it without rsync
!/artifacts/sweeps/
!/artifacts/sweeps/LEADERBOARD*.csv
!/artifacts/sweeps/LEADERBOARD*.md
!/artifacts/sweeps/*.json

# Track-provided Infineon data
!/data/raw/infineon/
!/data/raw/infineon/**


# OS / IDE
.DS_Store
.vscode/settings.json

# Slurm / runtime logs
logs/
slurm-*.out

# Leonardo / HPC transfer artifacts
leo_results_gpu.tgz
_leo_results_gpu/
*.tgz

# Local/GPU model checkpoints (default: ignore all sweep weights)
models/*.pt
models/*.pt.best
models/sweeps/*
models/sweeps/*.pt
models/sweeps/*.pkl

# Submission checkpoints only
!models/sweeps/.gitkeep
!models/sweeps/h_mod_nosched_mrr.pt.best
!models/sweeps/g_drop15_nosched_t2.pt.best

# Result scratch (keep final submission CSVs)
result/.staging_t2/
result/dev/
result/reproduce/
result/reproduce_t2/
