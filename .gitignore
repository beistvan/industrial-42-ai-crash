# Python bytecode (all levels — must follow un-ignore rules below)
**/__pycache__/
**/*.py[cod]
**/*$py.class
.venv/
venv/
.env
.env.*
!.env.example
.ipynb_checkpoints/
.pytest_cache/
.codex/

# Data / models
/data/raw/*
/data/processed/*
/artifacts/*

# Keep folder structure
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/artifacts/.gitkeep

# Keep sweep leaderboard metadata so teammates can read it without rsync
!/artifacts/sweeps/
!/artifacts/sweeps/LEADERBOARD*.csv
!/artifacts/sweeps/LEADERBOARD*.md
!/artifacts/sweeps/*.json

# Track-provided Infineon data
!/data/raw/infineon/
!/data/raw/infineon/**

# Re-ignore bytecode under vendor paths (negated above)
data/raw/infineon/**/__pycache__/
data/raw/infineon/**/*.pyc

# OS / IDE
.DS_Store
.vscode/settings.json

# Slurm / runtime logs
logs/
slurm-*.out

# HPC transfer artifacts (optional)
leo_results_gpu.tgz
_leo_results_gpu/
*.tgz

# Local/GPU model checkpoints (default: ignore all sweep weights)
models/*.pt
models/*.pt.best
models/sweeps/*
models/sweeps/*.pt
models/sweeps/*.pkl

# Submission checkpoints only
!models/sweeps/.gitkeep
!models/sweeps/h_mod_nosched_mrr.pt.best
!models/sweeps/g_drop15_nosched_t2.pt.best

# Result scratch (keep final submission CSVs)
result/.staging_t2/
result/dev/
result/reproduce/
result/reproduce_t2/
